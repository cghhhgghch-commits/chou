GEMINI_API_KEY=your_google_gemini_api_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
PORT=3001

# Notes:
# 1. Copy this file to .env and replace the values with your actual Supabase project details.
# 2. In Supabase, go to Project Settings > API to get the URL and anon key.
# 3. This app no longer depends on Firebase config files or demo fallback auth.

